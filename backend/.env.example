# Shared demo key; the frontend sends it in the X-API-Key header
API_KEY=change-me

# Folder with the model artifacts (defaults to backend/data)
DATA_DIR=./data

# Replay traffic. Default: DATA_DIR/test_edges.parquet (Sai's processed test edges),
# else the Oct 6 demo split in demo/2026-10-06_meeting/app/data/
# REPLAY_FILE=./data/test_edges.parquet

# Primary model: auto | graphsage | precomputed | heuristic
#   graphsage   -> DATA_DIR/graphsage_best_model.pt + DATA_DIR/preprocessing_objects.joblib (Sai)
#   precomputed -> DATA_DIR/primary_predictions.parquet (e.g. the decision model, model_5)
#   auto        -> precomputed, then graphsage, then the heuristic fallback
PRIMARY_MODEL=auto
# Name shown in the UI; defaults to primary_model in metrics.json
# PRIMARY_MODEL_NAME=model_5
# THRESHOLD=0.5

# Research tab and Metrics page
# MODEL_OUTPUTS=./data/model_outputs.jsonl
# METRICS_FILE=./data/metrics.json
# KNOWLEDGE_DIR=./data/knowledge          # put cti_chunks.jsonl and cve_chunks.jsonl here

# Retrieval: auto = vector search (RAG notebook) when chromadb + sentence-transformers are installed
# RAG_MODE=auto
# EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHROMA_DIR=./data/chroma_db
# BEHAVIOR_CHECK=true

# Explanations: groq | local | none
#   groq  -> Groq API (GROQ_API_KEY, GROQ_MODEL)
#   local -> any OpenAI-compatible server, e.g. the fine-tuned LLM (Model 4) served by vLLM or Ollama
#   none  -> evidence-only explanations
LLM_PROVIDER=none
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=uwf-finetuned
# LLM_API_KEY=
# Replace IPs with host aliases before anything is sent to the LLM
REDACT_IPS=true

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
