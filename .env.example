# Settings for docker compose (copy to .env; .env is not committed)
API_KEY=change-me                 # shared key between the console's nginx proxy and the backend (never sent to browsers)
NEO4J_PASSWORD=change-me-please   # 8+ characters
LLM_PROVIDER=groq                 # groq | none (evidence-only explanations)
GROQ_API_KEY=
# Optional login for the console (recommended whenever it is reachable from the internet)
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Port of the console on the host (80 on AWS if nothing else uses it)
CONSOLE_PORT=8080
AWS_REGION=us-west-2
# On AWS: leave DYNAMODB_ENDPOINT empty to use the real DynamoDB with the instance role
# DYNAMODB_ENDPOINT=
# DYNAMODB_CREATE_TABLE=false     # if the instance role cannot create tables
