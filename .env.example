# Settings for docker compose (copy to .env; .env is not committed)
API_KEY=change-me                 # shared key the console sends in X-API-Key
NEO4J_PASSWORD=change-me-please   # 8+ characters
LLM_PROVIDER=groq                 # groq | none (evidence-only explanations)
GROQ_API_KEY=
# Where the browser reaches the API (on AWS: the public API URL)
PUBLIC_API_URL=http://localhost:8000
AWS_REGION=us-west-2
